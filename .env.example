# Copy to .env for local development. Never commit .env.
KAR_ENVIRONMENT=development
KAR_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
KAR_SECRET_KEY=
# Development may use SQLite; staging/production MUST use MariaDB:
# KAR_DATABASE_URL=mysql+pymysql://kar_app:<password>@127.0.0.1:3306/kariakoo
KAR_DATABASE_URL=sqlite:///./kariakoo-dev.db
KAR_ALLOWED_HOSTS=["localhost","127.0.0.1"]
KAR_LOG_LEVEL=INFO
KAR_LOG_JSON=true
