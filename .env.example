# Copy to .env for local development. Never commit .env.
BM_ENVIRONMENT=development
BM_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BM_SECRET_KEY=
# Development may use SQLite; staging/production MUST use PostgreSQL:
# BM_DATABASE_URL=postgresql+psycopg://bm_app:<password>@127.0.0.1:5432/bongomarkets
BM_DATABASE_URL=sqlite:///./bongo-markets-dev.db
BM_ALLOWED_HOSTS=["localhost","127.0.0.1"]
BM_LOG_LEVEL=INFO
BM_LOG_JSON=true
