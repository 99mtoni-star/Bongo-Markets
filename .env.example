# Copy to .env for local development. Never commit .env.
BM_ENVIRONMENT=development
BM_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BM_SECRET_KEY=
# Application connects as the least-privilege role (bm_app). PostgreSQL only.
BM_DATABASE_URL=postgresql+psycopg://bm_app:<password>@127.0.0.1:5432/bongomarkets
# Migrations only (schema owner). Not used by the running app.
BM_MIGRATION_DATABASE_URL=postgresql+psycopg://bm_owner:<password>@127.0.0.1:5432/bongomarkets
# Production: mount secrets as files instead (SEC-KEY-002), e.g. BM_SECRETS_DIR=/run/secrets
# Backups
BM_BACKUP_DATABASE_URL=postgresql+psycopg://bm_owner:<password>@127.0.0.1:5432/bongomarkets
BM_BACKUP_KEY_FILE=/run/secrets/bm_backup_key
BM_BACKUP_DIR=./backups
BM_BACKUP_RETENTION_DAYS=30
BM_ALLOWED_HOSTS=["localhost","127.0.0.1"]
BM_LOG_LEVEL=INFO
BM_LOG_JSON=true
